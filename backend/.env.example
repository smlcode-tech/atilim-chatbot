# Bu dosyayı backend/.env olarak kopyala ve anahtarlarını yaz. .env git'e girmez.

# --- LLM (sohbet) ---
# Groq ücretsiz: https://console.groq.com/keys
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# --- Embedding (Voyage AI) ---
# https://dashboard.voyageai.com/ — model değişirse indeks silinip yeniden kurulmalı.
VOYAGE_API_KEY=
# EMBED_MODEL=voyage-multilingual-2

# --- Giriş ve konuşma geçmişi ---
# Üçü birden boş bırakılırsa asistan geçmişsiz çalışır.
# MONGODB_URI=mongodb+srv://kullanici:parola@kume.mongodb.net/
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# JWT_SECRET=en-az-32-bayt-rastgele-bir-deger

# --- Diğer isteğe bağlı ayarlar (varsayılanlar config.py içinde) ---
# RETRIEVAL_TOP_K=6
# HISTORY_TURNS=6
# QUOTA_COOLDOWN_SECONDS=3600
# DAILY_QUESTION_LIMIT=30
# GUEST_DAILY_QUESTION_LIMIT=10
# MONGODB_DB=atilim_assistant
# JWT_TTL_HOURS=720
# DATA_DIR=data
