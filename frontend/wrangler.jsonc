// Cloudflare Workers yayın tanımı: statik arayüz + `/api/*` vekili (`worker/index.ts`).
// `PROXY_SECRET` burada değil, Worker'ın Settings → Variables & Secrets bölümünde durur.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atilim-chatbot",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "vars": {
    "API_ORIGIN": "https://atilim-assistant-api.onrender.com"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
